{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathframe.dev/schemas/task-packet-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change", "task", "title", "execution_policy", "role", "objective", "acceptance", "references", "context", "dependencies", "completed_prerequisites", "write_scope", "write_scope_assurance", "constraints", "verification", "result_schema", "host_assurance", "omissions", "budget"],
  "properties": {
    "schema": {"const": "pathframe.task/v1"},
    "change": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "execution_policy": {"enum": ["brain", "delegated"]},
    "role": {"$ref": "role-v1.schema.json"},
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {"type": "string", "minLength": 1},
    "references": {"type": "array", "items": {"type": "string"}},
    "context": {"type": "array", "items": {"type": "object", "required": ["layer", "path", "required", "content", "bytes"]}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "completed_prerequisites": {"type": "array", "items": {"type": "string"}},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "write_scope_assurance": {"enum": ["advisory", "host_enforced"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "result_schema": {"const": "pathframe.task-result/v1"},
    "host_assurance": {"enum": ["not_evaluated", "declared"]},
    "omissions": {"type": "array", "items": {"type": "object", "required": ["layer", "path", "reason", "bytes"]}},
    "budget": {"type": "object", "required": ["limit_bytes", "required_bytes", "included_bytes", "omitted_bytes"]}
  }
}
